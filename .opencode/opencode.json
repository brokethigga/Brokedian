{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "build",
  "instructions": [
    "../../GEMINI.md",
    "instructions/INSTRUCTIONS.md"
  ],
  "agent": {
    "build": {
      "description": "Primary coding agent for development work",
      "mode": "primary",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true
      }
    },
    "planner": {
      "description": "Expert planning specialist for complex features.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/planner.txt}",
      "tools": { "read": true, "bash": true }
    },
    "architect": {
      "description": "System design and scalability specialist.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/architect.txt}"
    },
    "code-reviewer": {
      "description": "Quality and maintainability specialist.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/code-reviewer.txt}"
    },
    "security-reviewer": {
      "description": "Vulnerability detection specialist.",
      "mode": "subagent",
      "prompt": "{file:prompts/agents/security-reviewer.txt}"
    }
  }
}
